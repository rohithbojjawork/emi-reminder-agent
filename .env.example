# Copy to .env and fill in. .env is git-ignored; never put real keys in this template.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Used when LLM_API_KEY is empty
OPENAI_API_KEY=
# Language-ID model; defaults to LLM_MODEL
LID_MODEL=

# --- Speech: Azure (STT + TTS) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Optional: pin "today" (YYYY-MM-DD) to make promise-to-pay dates reproducible
TODAY=

# --- Behavior settings ---
# Turn end: normal = 1.5 s silence | fast = 0.6 s | smart = smart-turn v3 model
TURN_MODE=fast
# Language switching: implicit | explicit | custom
LANG_SWITCH_MODE=implicit
# custom mode: path to your own language-switch prompt; starting it with <explicit_language_prompt> makes it explicit
LID_PROMPT_FILE=
# Language ID: tiered (heuristic, then LLM) | llm | heuristic
LID_STRATEGY=tiered
# Minimum words before an implicit language switch
MIN_WORDS_FOR_LANG_SWITCH=2
# Minimum words before barge-in; 1 interrupts on any speech VAD hears
MIN_WORDS_FOR_BARGE_IN=2
# false = the greeting with the AI/recording disclosure always plays in full
INITIAL_MESSAGE_BARGE=false
